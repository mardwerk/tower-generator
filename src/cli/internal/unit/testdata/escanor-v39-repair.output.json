  "reservedTechniques": [
    {
      "name": "Pride Flare",
      "reason": "Its defining instant, extreme heat effect is not represented by bounded ordinary splash or burn."
    },
    {
      "name": "Final Prominence",
      "reason": "Its gigantic thrown fireball is a separate delivery the attack and boost cannot express."
    },
    {
      "name": "Divine Sword Escanor",
      "reason": "Its defining destruction of Ominous Nebula has no supported equivalent."
    },
    {
      "name": "Divine Spear Escanor",
      "reason": "A finger thrust is not represented by pierce, which only caps distinct enemies hit along the attack path."
    },
    {
      "name": "Daytime",
      "reason": "No clock or time-dependent transformation is implemented."
    },
    {
      "name": "Night-time",
      "reason": "No time-of-day state or triggered weakness is implemented."
    },
    {
      "name": "The One: Ultimate",
      "reason": "The life-force cost and resulting death are unsupported."
    },
    {
      "name": "Large Spear",
      "reason": "The cited passages establish possession but no combat behavior to adapt."
    },
    {
      "name": "Magic Glasses",
      "reason": "An equipment toggle that triggers transformation is unsupported."
    }
  ],
  "unsupportedMechanics": [
    {
      "name": "Sunshine's daily cycle and physical transformation",
      "reason": "No real-time clock, changing body, or day/night transformation operator exists."
    },
    {
      "name": "Rhitta's recall and stored-heat release action",
      "reason": "The attack cannot express a separate recall or independent heat-release action."
    },
    {
      "name": "Independent Cruel Sun or Crazy Prominence suns",
      "reason": "The attack cannot spawn and steer separate suns with independent movement or delivery."
    },
    {
      "name": "The One's exact noon trigger, one-minute form, and invulnerability",
      "reason": "The manual attack boost has no clock trigger or invulnerability behavior; its duration and cooldown are proposed gameplay values."
    },
    {
      "name": "Human bodily damage from Sunshine",
      "reason": "The unit has no health, self-damage, or death mechanic."
    }
  ],
