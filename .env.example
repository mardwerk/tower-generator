OPENROUTER_API_KEY=
# Optional. Omit to use the free router.
OPENROUTER_MODEL=openrouter/free
# Optional. none keeps interactive drafts fast; low, medium and high are also supported.
OPENROUTER_REASONING=none

# Local Codex defaults. Settings or CLI flags override these values.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING=medium

# Optional paid icon generation. Every image requires confirmation in its icon dialog.
OPENROUTER_IMAGE_MODEL=meta/muse-image
